BOT_QQ=YOUR_BOT_QQ
HOST=127.0.0.1
PORT=8765
LOG_LEVEL=INFO

# 账号管理系统（见 docs/accounts.md）。两个开关默认关闭。
# 关闭时行为与账号化之前逐条一致：不创建 data/accounts/ 下任何文件，也不介入
# 任何消息链路。回退只需改回 false 并重启。
ACCOUNT_SYSTEM_ENABLED=false
# 开启后当前账号由 NapCat 实际登录号（get_login_info）决定，BOT_QQ 降级为
# 引导用的默认账号。未在 WebUI 里确认过的新账号不会获得数据区，行为等同
# 今天的"账号不一致"（忽略全部消息并告警）。
ACCOUNT_FOLLOW_NAPCAT=false
ACCOUNTS_DB_PATH=data/accounts/index.sqlite3

# NapCat 必须使用与其匹配的项目专用 QQ，不能指向桌面自动更新版 QQ。
QQ_EXE=C:\Path\To\NapCat.Shell\QQ.exe
NAPCAT_DIR=C:\Path\To\NapCat.Shell\versions\QQ_VERSION\resources\app\napcat
# 专用 Electron 配置目录；不得设为 %APPDATA%\QQ。
QQ_PROFILE_DIR=data/runtime/qq-profile

# private: only reply to private messages
# mention: private messages + group messages that mention the bot or "亚托莉"
# smart: private messages + owner/group direct triggers; avoids replying to every group message
# all: reply to all messages (not recommended)
REPLY_MODE=smart

# Default: local Ollama OpenAI-compatible chat API.
# Leave OPENAI_API_KEY empty to use local fallback replies only.
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_MODEL=qwen3:4b-instruct
OLLAMA_MODELS=%LOCALAPPDATA%\Ollama\models
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_QUEUE=32
OLLAMA_KEEP_ALIVE=0
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0

# Controls the reply style when an API key is configured.
TEMPERATURE=0.60
FREQUENCY_PENALTY=0.35
MAX_TOKENS=180
CHAT_REQUEST_TIMEOUT_SECONDS=25
CHAT_RESOURCE_WAIT_SECONDS=35
CHAT_QUALITY_RETRIES=1

# Send replies as several short QQ messages, like streaming.
MESSAGE_SPLIT_MAX_CHARS=44
MESSAGE_SPLIT_MAX_PARTS=4
MESSAGE_SEND_DELAY_MIN=0.55
MESSAGE_SEND_DELAY_MAX=1.35

# Local stickers. Put images under data/stickers/<emotion>/.
STICKER_DIR=data/stickers
STICKER_TRIGGER_FILE=data/stickers/triggers.json
STICKER_CHANCE=0.32
STICKER_COOLDOWN_SECONDS=120
STICKER_CAPTURE_ENABLED=true
STICKER_CAPTURE_MAX_BYTES=3000000
# Incoming sticker archive; defaults to Documents/Tencent Files/<BOT_QQ>/ATRI/chat_history.
# STICKER_CAPTURE_DIR=%USERPROFILE%/Documents/Tencent Files/YOUR_BOT_QQ/ATRI/chat_history
# QQ_RECORDS_ROOT=%USERPROFILE%/Documents/Tencent Files

# User habit memory and light idle care.
MEMORY_PATH=data/memory/users.json
# JSON 仍是唯一可编辑事实源。SQLite+FTS5 只是可重建索引，默认不加载 bge-m3。
MEMORY_RETRIEVAL_ENABLED=true
MEMORY_RETRIEVAL_PATH=data/memory/semantic_memory.sqlite3
MEMORY_RETRIEVAL_MAX_CHARS=1800
MEMORY_RETRIEVAL_LORE_LIMIT=3
MEMORY_RETRIEVAL_MEMORY_LIMIT=5
MEMORY_VECTOR_ENABLED=false
MEMORY_EMBEDDING_MODEL=bge-m3:latest
MEMORY_EMBEDDING_BASE_URL=http://127.0.0.1:11434
MEMORY_EMBEDDING_TIMEOUT_SECONDS=2
MEMORY_EXTRACTION_ENABLED=true
MEMORY_EXTRACTION_LLM_ENABLED=true
MEMORY_EXTRACTION_MODEL=deepseek-v4-flash
MEMORY_EXTRACTION_BASE_URL=https://api.deepseek.com/v1
MEMORY_EXTRACTION_TIMEOUT_SECONDS=10
MEMORY_EXTRACTION_COOLDOWN_SECONDS=45
MEMORY_BACKFILL_ENABLED=true
MEMORY_BACKFILL_MAX_CONVERSATIONS=250
OWNER_QQ=
# New context-aware private proactive scheduler. Set false to immediately use the legacy idle/morning loops.
PROACTIVE_V2_ENABLED=false
IDLE_PROACTIVE_ENABLED=true
IDLE_MINUTES=120
IDLE_COOLDOWN_MINUTES=480
IDLE_CHECK_SECONDS=60

# Group chat context and low-frequency cold-room nudges.
# Hard cap is 3 proactive messages per group per day.
GROUP_CONTEXT_ENABLED=true
GROUP_PROACTIVE_ENABLED=true
GROUP_PROACTIVE_IDLE_MINUTES=60
GROUP_PROACTIVE_COOLDOWN_MINUTES=180
GROUP_PROACTIVE_DAILY_LIMIT=3
GROUP_PROACTIVE_CHECK_SECONDS=90

# Daily morning greeting. If OWNER_QQ is empty, it sends to private users who have chatted with her.
MORNING_GREETING_ENABLED=true
MORNING_GREETING_TIME=07:30
MORNING_GREETING_TIMEZONE=Asia/Shanghai
MORNING_GREETING_CATCHUP_MINUTES=90

# Material toolbox: documents, tables, webpages, images, and direct video files.
TOOLBOX_ENABLED=true
TOOLBOX_TIMEOUT_SECONDS=18
TOOLBOX_MAX_BYTES=2000000
TOOLBOX_MAX_DOCUMENT_BYTES=20000000
TOOLBOX_MAX_MEDIA_BYTES=80000000
TOOLBOX_VISION_ENABLED=true
TOOLBOX_VISION_MODEL=qwen3-vl:8b-instruct
TOOLBOX_VISION_FALLBACK_MODEL=qwen3-vl:4b-instruct
TOOLBOX_VISION_BASE_URL=http://127.0.0.1:11434/v1
TOOLBOX_VISION_API_KEY=ollama
TOOLBOX_VISION_MAX_BYTES=8000000
TOOLBOX_VISION_RETRY_COUNT=0
TOOLBOX_VISION_RESOURCE_WAIT_SECONDS=10
TOOLBOX_VISION_TIMEOUT_SECONDS=55
TOOLBOX_VISION_UNLOAD_OTHER_OLLAMA_MODELS=true
TOOLBOX_OCR_ENABLED=true
TOOLBOX_VIDEO_FRAME_ANALYSIS_ENABLED=true
TOOLBOX_VIDEO_MAX_FRAMES=4
TOOLBOX_VIDEO_DEADLINE_SECONDS=60

# LLM Agent tool loop: every turn chooses a real tool action or final_answer.
LLM_TOOLS_ENABLED=true
LLM_TOOL_MAX_CALLS=2
LLM_AGENT_PROTOCOL_ENABLED=false
LLM_AGENT_MAX_STEPS=6
LLM_AGENT_MAX_TOOL_CALLS=3
HUMAN_REPLY_PIPELINE_ENABLED=true

# 持续认知内核。影子模式只维护目标、思维承接、情绪和自我经历，
# 不会替代当前回复、发送 QQ 消息或执行副作用工具。
COGNITION_SHADOW_ENABLED=true
COGNITION_STATE_PATH=data/cognition/state.sqlite3
COGNITION_SHADOW_TIMEOUT_SECONDS=2
COGNITION_SHADOW_MAX_CONCURRENCY=2
WEB_SEARCH_ENABLED=true
WEB_SEARCH_TIMEOUT_SECONDS=6
WEB_SEARCH_MAX_RESULTS=5
# 可在桌面「设置 → 联网搜索」或 WebUI「高级配置」中填写。
# 按 Tavily、SerpAPI、SearXNG 顺序尝试；留空时使用免费来源。
TAVILY_API_KEY=
SERPAPI_API_KEY=
# 自建 SearXNG 地址，多个用英文逗号分隔，例如 http://127.0.0.1:8080
ATRI_SEARXNG_INSTANCES=
WEB_PAGE_MAX_CHARS=8000
WEB_GROUNDING_REVIEW_ENABLED=true

# QQ 空间动态管理。依赖本机 onebot-qzone Bridge；默认关闭。
# Cookie 只配置在 Bridge 中，不要写入本项目 .env。
QZONE_BRIDGE_ENABLED=false
QZONE_BRIDGE_URL=http://127.0.0.1:5700
QZONE_BRIDGE_TOKEN=
QZONE_BRIDGE_TIMEOUT_SECONDS=8
# Bridge 默认不随桌宠/NapCat 自动启动（避免聊天账号在后台持续做空间网页自动化）。
# 只有显式设为 true 才恢复"开机即连"；平时请在 WebUI → 高级配置里手动启动/停止。
QZONE_BRIDGE_AUTOSTART=false
QZONE_AUTOMATION_DB=data/qzone_automation.sqlite3

# 拟人打字节奏：按字数估算"打完这条消息"的时间，再叠加随机抖动。
# MESSAGE_SEND_DELAY_MIN/MAX 表示停手后的停顿区间，打字耗时按下面速度叠加。
TYPING_CHARS_PER_SECOND=5.5
TYPING_MAX_DELAY_SECONDS=12
# 首条回复前的停顿（读消息 + 起手打字），比段间间隔更长、更随机。
REPLY_FIRST_DELAY_MIN=0.8
REPLY_FIRST_DELAY_MAX=2.5

# Voice is isolated behind a localhost service and disabled by default.
VOICE_ASR_ENABLED=false
VOICE_TTS_ENABLED=false
VOICE_SERVICE_URL=http://127.0.0.1:8790
VOICE_SERVICE_TIMEOUT_SECONDS=180
# 可选后台预热；共享电脑默认关闭，专用角色 Bot 可开启。
ATRI_TTS_PREWARM_ENABLED=false
# GPT-SoVITS 合成结束后的复用窗口（秒）。
ATRI_TTS_IDLE_SHUTDOWN_SECONDS=300
ATRI_TTS_INFERENCE_TIMEOUT_SECONDS=25
ATRI_TTS_RESOURCE_WAIT_SECONDS=8
ATRI_TTS_TOTAL_TIMEOUT_SECONDS=75
ATRI_TTS_STARTUP_TIMEOUT_SECONDS=45
VOICE_PROFILE=atri-official-v2pro-curated
# Optional language-specific primary profile. Leave empty unless the local profile exists.
VOICE_ZH_PROFILE=
VOICE_GROUP_ENABLED=false
VOICE_REPLY_TO_VOICE=false
VOICE_MAX_CHARS=100
VOICE_SEGMENT_MAX_CHARS=100
VOICE_COOLDOWN_SECONDS=30
VOICE_INPUT_MAX_BYTES=20000000

# Voice-service ASR quality settings (read when the voice service starts).
ATRI_ASR_PREPROCESS_ENABLED=true
ATRI_ASR_VAD_MAX_SEGMENT_MS=30000
ATRI_ASR_MAX_DURATION_SECONDS=300
# CPU worker is reused within this idle window; 0 restores per-request exit.
# CUDA workers always exit after each request to release VRAM for TTS.
ATRI_ASR_WORKER_IDLE_SECONDS=60
ATRI_ASR_LEXICON_PATH=data/voice/asr-hotwords.json
ATRI_TTS_PRONUNCIATION_PATH=data/voice/tts-pronunciations.json
ATRI_TTS_POSTPROCESS_ENABLED=true
ATRI_TTS_TARGET_RMS_DBFS=-22
ATRI_TTS_MAX_GAIN_DB=6
ATRI_ORIGINAL_VOICE_LIBRARY=data/voice/originals
ATRI_ORIGINAL_CLIP_ENABLED=true
ATRI_TTS_QUALITY_GATE_ENABLED=true
ATRI_TTS_QUALITY_MAX_ERROR_RATE=0.22
ATRI_TTS_QUALITY_RETRIES=1
ATRI_SINGING_ENABLED=true
ATRI_SINGING_PIPELINE_MANIFEST=data/voice/singing-pipeline.json
ATRI_SINGING_MAXIMUM_JOBS=50

# 回复质量评测与群聊总结（独立旁路）。数据库只保存在本机。
INSIGHTS_DB_PATH=data/insights/insights.sqlite3
EVALUATION_ENABLED=true
# 系统程序自动评测 ATRI 实际回复。
SYSTEM_EVALUATION_ENABLED=true
# 直接复用“模型”页面当前激活的聊天模型作为评测器。
EVALUATION_USE_CHAT_MODEL=true
# 留空跟随当前聊天模型；填写“模型”页面中某个聊天档案 id 可单独指定评测模型。
EVALUATION_MODEL_PROFILE_ID=
# 评测默认直接复用“模型”页面当前激活的聊天模型；以下三项仅在
# EVALUATION_USE_CHAT_MODEL=false 时作为旧版独立 Judge 配置使用。
EVALUATION_BASE_URL=https://api.deepseek.com/v1
EVALUATION_API_KEY=
EVALUATION_MODEL=deepseek-chat
EVALUATION_TIMEOUT_SECONDS=45
EVALUATION_WORKERS=1
EVALUATION_QUEUE_SIZE=256
EVALUATION_DIMENSIONS=relevancy,accuracy,completeness,coherence,faithfulness,hallucination
EVALUATION_SEMANTIC_ENABLED=true
EVALUATION_SEMANTIC_WEIGHT=0.15
INSIGHTS_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# true 时只使用已下载到本机缓存的向量模型，不联网下载。
INSIGHTS_EMBEDDING_LOCAL_ONLY=false

# 群消息归档默认开启；仅写入本机 SQLite，不改变 QQ 回复策略。
GROUP_CHAT_ARCHIVE_ENABLED=true
GROUP_SUMMARY_ENABLED=true
# 旧版全局定时字段仅为兼容旧配置保留；新的自动总结计划请在 WebUI 的“群聊总结”中逐群设置，默认全部关闭。
GROUP_SUMMARY_SCHEDULE_ENABLED=false
GROUP_SUMMARY_SCHEDULE_TIME=00:10
GROUP_SUMMARY_SCHEDULE_PERIOD=daily
# WebUI 计划的日报按最近24小时、周报按最近7天、月报按当前自然月生成。
GROUP_SUMMARY_LOOKBACK_HOURS=24
GROUP_SUMMARY_MIN_MESSAGES=20
# 旧版群号筛选字段仅保留兼容；逐群计划不再使用它。
GROUP_SUMMARY_GROUP_IDS=
GROUP_SUMMARY_MAX_MESSAGES=3000
GROUP_SUMMARY_CLUSTER_THRESHOLD=0.52
GROUP_SUMMARY_MAX_TOPICS=8
